      }
    },
    {
      "name": "08｜Configuración y arranque",
      "description": "Llamadas a pua_setup según action y outcome. queued o running solo indican que el trabajo se envió o espera; no que la compilación o el arranque en segundo plano hayan terminado.",
      "query": {
        "kind": "TrendsQuery",
        "dateRange": {
          "date_from": "-30d"
        },
        "interval": "day",
        "properties": [
          {
            "key": "environment",
            "value": [
              "production"
            ],
            "operator": "exact",
